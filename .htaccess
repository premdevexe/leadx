# LeadX Root Security Hardening (cPanel & Apache Shared Hosting)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to hidden files and sensitive project files
    RewriteRule ^\.(.*)$ - [F,L]
    RewriteRule ^(composer\.(json|lock)|package\.(json|lock)|artisan|\.env.*|.*\.lock)$ - [F,L]
    RewriteRule ^storage/app/installer/(.*)$ - [F,L]
</IfModule>

<FilesMatch "^(\.env|\.git|composer\.|package\.|artisan|.*\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
